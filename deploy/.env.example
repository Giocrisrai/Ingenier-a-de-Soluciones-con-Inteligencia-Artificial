# deploy/.env.example — Variables del despliegue (NO poner secretos reales aquí).
# Copia a deploy/.env y completa en la máquina destino:  cp deploy/.env.example deploy/.env

# --- Proveedor del modelo ---
# Por defecto Groq, igual que el resto del curso: https://console.groq.com/
GROQ_API_KEY=""
AGENT_MODEL="openai/gpt-oss-20b"

# El backend NO está atado a Groq. Habla el protocolo estándar tipo OpenAI, que
# usan casi todos los proveedores, así que cambiar de uno a otro son estas dos
# variables y el nombre del modelo — sin tocar una línea de código.
# Déjalas vacías para usar Groq.
#
#   Mistral:   LLM_BASE_URL="https://api.mistral.ai/v1"   AGENT_MODEL="mistral-small-latest"
#   Together:  LLM_BASE_URL="https://api.together.xyz/v1"
#   Ollama:    LLM_BASE_URL="http://localhost:11434/v1"   (modelo local, sin clave)
#
# LLM_BASE_URL=""
# LLM_API_KEY=""

# --- Observabilidad (opcional, reusa RA3.1/3.2) ---
LANGSMITH_TRACING="false"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="ingenieria_soluciones_con_ia"

# --- URL interna del backend que usa el frontend (red docker) ---
BACKEND_URL="http://backend:8000"

# --- Docs interactivas de FastAPI (/docs, /redoc, /openapi.json) ---
# Apagadas por defecto: Caddy publica el backend en /api/*, así que activarlas
# expone en Internet el catálogo de endpoints y un formulario para dispararlos.
# Ponlo en "true" solo mientras desarrollas en local.
ENABLE_DOCS="false"

# --- Dirección del sitio para Caddy (el Caddyfile usa 'tls internal') ---
# El Caddyfile emite un certificado self-signed con la CA interna de Caddy, así
# que el navegador mostrará un aviso (normal en este curso).
#   - Local:        SITE_ADDRESS=localhost   (abre https://localhost)
#   - EC2 por IP:   SITE_ADDRESS=https://TU_IP_PUBLICA   (p. ej. https://203.0.113.10)
#                   Necesario para que Caddy emita el cert para ESA IP y sirva HTTPS.
#   - Dominio real: SITE_ADDRESS=tudominio.com  y QUITA 'tls internal' del Caddyfile
#                   para obtener un certificado válido (Let's Encrypt).
SITE_ADDRESS="localhost"
