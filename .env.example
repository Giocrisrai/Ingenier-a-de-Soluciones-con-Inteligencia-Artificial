# ===========================================
# Variables de Entorno - Curso IA
# ===========================================
# Copia este archivo como .env y completa con tus credenciales:
#   cp .env.example .env
# Docker Compose exige que exista `.env` en la raíz (puede tener valores vacíos si solo abres Jupyter).
#
# IMPORTANTE: Nunca subas el archivo .env al repositorio

# --- Groq API (proveedor de LLMs del curso) ---
# Tu API key personal de Groq. Empieza con "gsk_".
# Obtener en: https://console.groq.com/ > API Keys > Create API Key
# Sugerido: crear la cuenta con tu correo Duoc UC. NO hace falta tarjeta de crédito.
GROQ_API_KEY=""

# Modelo principal del curso. Groq retiró llama-3.3-70b-versatile el 16-ago-2026;
# el reemplazo oficial es openai/gpt-oss-120b (open-weight servido por Groq, no la API de OpenAI).
GROQ_MODEL="openai/gpt-oss-120b"

# Modelo rápido, para tareas simples o con muchas llamadas.
# Capa gratuita (ago 2026): ambos gpt-oss tienen 200K tokens/día; este es ~2× más rápido.
GROQ_MODEL_FAST="openai/gpt-oss-20b"

# Modelo para agentes que encadenan VARIAS llamadas a herramientas seguidas.
# Los modelos Llama en Groq fallan a menudo en cadenas multi-paso: devuelven la llamada
# a la función mal formada y la API responde 400 `tool_use_failed`. Medido con una cadena
# de 2 pasos, 4 intentos: llama-3.1-8b 2/4 · openai/gpt-oss-20b 4/4.
# (Es un modelo open-weight servido por Groq, no la API de OpenAI.)
GROQ_MODEL_TOOLS="openai/gpt-oss-20b"

# --- Proveedor alternativo: Mistral (opcional) ---
# Plan B si agotas la cuota diaria de Groq. Gratis y sin tarjeta:
# https://console.mistral.ai/api-keys
# Límites medidos en agosto 2026: 50 peticiones/min, 50.000 tokens/min, sin tope
# diario declarado. Cómo usarlo: ver GUIA_DEL_ESTUDIANTE.md, apartado 4.b.
MISTRAL_API_KEY=""

# --- Embeddings (locales) ---
# Groq NO ofrece endpoint de embeddings, así que el curso usa un modelo local de
# HuggingFace: gratis, sin API key y funciona offline. La primera ejecución
# descarga ~470 MB y los deja en caché.
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# Modelo por defecto del agente desplegado (deploy/)
AGENT_MODEL="openai/gpt-oss-20b"

# --- LangSmith (Observabilidad) — OPCIONAL ---
# Se queda en "false" hasta que llegues a los módulos de observabilidad
# (RA1/IL1.4 y RA3) y tengas tu LANGSMITH_API_KEY.
#
# Si lo pones en "true" con la API key vacía, LangChain intenta enviar trazas y
# la consola se llena de errores rojos que NO son un fallo de tu código:
#   LangSmithMissingAPIKeyWarning: API key must be provided...
#   Failed to multipart ingest runs: LangSmithAuthError: 401 Unauthorized
# Rellena primero LANGSMITH_API_KEY y solo entonces cámbialo a "true".
LANGSMITH_TRACING="false"

# Tu API key de LangSmith
# Obtener en: https://smith.langchain.com/ > Settings > API Keys
LANGSMITH_API_KEY=""

# Nombre del proyecto en LangSmith
LANGSMITH_PROJECT="ingenieria_soluciones_con_ia"
