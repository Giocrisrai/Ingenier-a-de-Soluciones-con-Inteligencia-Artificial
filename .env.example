# ===========================================
# Variables de Entorno - Curso IA
# ===========================================
# Copia este archivo como .env y completa con tus credenciales:
#   cp .env.example .env
# Docker Compose exige que exista `.env` en la raíz (puede tener valores vacíos si solo abres Jupyter).
#
# IMPORTANTE: Nunca subas el archivo .env al repositorio

# --- Groq API (proveedor de LLMs del curso) ---
# Tu API key personal de Groq. Empieza con "gsk_".
# Obtener en: https://console.groq.com/ > API Keys > Create API Key
# Sugerido: crear la cuenta con tu correo Duoc UC. NO hace falta tarjeta de crédito.
GROQ_API_KEY=""

# Modelo principal del curso (el de la guía oficial)
GROQ_MODEL="llama-3.3-70b-versatile"

# Modelo rápido y económico, para tareas simples o con muchas llamadas.
# Útil para no agotar la cuota gratuita: el modelo grande solo tiene 100K tokens/día,
# mientras que este tiene 500K. Ese límite diario (TPD) es el que se agota primero.
GROQ_MODEL_FAST="llama-3.1-8b-instant"

# Modelo para agentes que encadenan VARIAS llamadas a herramientas seguidas.
# Los modelos Llama en Groq fallan a menudo en cadenas multi-paso: devuelven la llamada
# a la función mal formada y la API responde 400 `tool_use_failed`. Medido con una cadena
# de 2 pasos, 4 intentos: llama-3.1-8b 2/4 · openai/gpt-oss-20b 4/4.
# (Es un modelo open-weight servido por Groq, no la API de OpenAI.)
GROQ_MODEL_TOOLS="openai/gpt-oss-20b"

# --- Embeddings (locales) ---
# Groq NO ofrece endpoint de embeddings, así que el curso usa un modelo local de
# HuggingFace: gratis, sin API key y funciona offline. La primera ejecución
# descarga ~470 MB y los deja en caché.
EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"

# Modelo por defecto del agente desplegado (deploy/)
AGENT_MODEL="llama-3.1-8b-instant"

# --- LangSmith (Observabilidad) ---
# Habilitar trazabilidad con LangSmith
LANGSMITH_TRACING="true"

# Tu API key de LangSmith
# Obtener en: https://smith.langchain.com/ > Settings > API Keys
LANGSMITH_API_KEY=""

# Nombre del proyecto en LangSmith
LANGSMITH_PROJECT="ingenieria_soluciones_con_ia"
